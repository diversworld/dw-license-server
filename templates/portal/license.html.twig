{% extends 'base.html.twig' %}{% block body %}<main class="container py-4"><a href="{{ path('portal_index', {_locale: app.request.locale}) }}">{{ 'portal.title'|trans }}</a>
<h1>{{ license.product.name }}</h1><p>{{ 'portal.expiry'|trans }}: {{ license.expiresAt ? license.expiresAt|date('Y-m-d') : 'portal.unlimited'|trans }}</p><p>{{ 'portal.features'|trans }}: {{ license.features|join(', ') }}</p>
<p>{{ 'entitlements.installations'|trans }}: {{ license.maxDomains }}</p>{% if license.quotas %}<ul>{% for feature, limit in license.quotas %}<li>{{ feature }}: {{ limit }}</li>{% endfor %}</ul>{% endif %}{% if license.updatesAllowed is not null %}<p>{{ 'entitlements.updates'|trans }}: {{ (license.updatesAllowed ? 'entitlements.allowed_updates' : 'entitlements.no_updates')|trans }}{% if license.updatesUntil %} — {{ license.updatesUntil|date('Y-m-d') }}{% endif %}</p>{% endif %}
<a href="{{ path('portal_download', {id: license.id, _locale: app.request.locale}) }}">{{ 'portal.download'|trans }}</a>
<h2>{{ 'portal.installations'|trans }}</h2><ul>{% for installation in installations %}<li>{{ installation.domain }} — {{ installation.tenant }} {% if installation.active %}<a href="{{ path('portal_domain', {id: installation.id, _locale: app.request.locale}) }}">{{ 'portal.change_domain'|trans }}</a>{% endif %}</li>{% endfor %}</ul>
<h2>{{ 'portal.history'|trans }}</h2><ul>{% for entry in history %}<li>{{ entry.createdAt|date('Y-m-d H:i') }} — {{ ('license_action.' ~ entry.action)|trans }}: {{ entry.reason }}{% if entry.details.fromDomain is defined %} ({{ entry.details.fromDomain }} → {{ entry.details.toDomain }}){% endif %}</li>{% endfor %}</ul></main>{% endblock %}
