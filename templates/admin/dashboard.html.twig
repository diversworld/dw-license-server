{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    {{ 'ui.overview'|trans }}
{% endblock %}

{% block main %}

    {# =========================================================
       Hauptkennzahlen
       ========================================================= #}
    <div class="row g-3 mb-4">

        {# Kunden #}
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted mb-2">
                        <i class="fa fa-users me-2"></i>
                        {{ 'ui.active_customers'|trans }}
                    </div>
                    <div class="fs-2 fw-bold">
                        {{ stats.customers.active }}
                    </div>
                    <div class="small text-muted">
                        {{ stats.customers.total }} {{ 'ui.total'|trans }}
                    </div>
                </div>
            </div>
        </div>

        {# Aktive Lizenzen #}
        <div class="col-12 col-md-6 col-xl-3">
            <a
                href="{{ dashboardUrls.activeLicenses }}"
                class="text-decoration-none text-reset"
            >
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            <i class="fa fa-key me-2"></i>
                            {{ 'ui.active_licenses'|trans }}
                        </div>
                        <div class="fs-2 fw-bold">
                            {{ stats.licenses.active }}
                        </div>
                        <div class="small text-muted">
                            {{ stats.licenses.total }} {{ 'ui.total'|trans }}
                        </div>
                    </div>
                </div>
            </a>
        </div>

        {# Installationen #}
        <div class="col-12 col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="text-muted mb-2">
                        <i class="fa fa-globe me-2"></i>
                        {{ 'ui.active_installations'|trans }}
                    </div>
                    <div class="fs-2 fw-bold">
                        {{ stats.activations.active }}
                    </div>
                    <div class="small text-muted">
                        {{ stats.activations.total }} {{ 'ui.total'|trans }}
                    </div>
                </div>
            </div>
        </div>

        {# Läuft bald ab #}
        <div class="col-12 col-md-6 col-xl-3">
            <a
                href="{{ dashboardUrls.expiringLicenses }}"
                class="text-decoration-none text-reset"
            >
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <div class="text-muted mb-2">
                            <i class="fa fa-clock me-2"></i>
                            {{ 'ui.expiring_soon'|trans }}
                        </div>
                        <div class="fs-2 fw-bold">
                            {{ stats.licenses.expiring }}
                        </div>
                        <div class="small text-muted">
                            {{ 'ui.within_days'|trans }}
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-info">
            <div class="card-body">
                <h5 class="card-title">
                    {{ 'ui.audit_entries'|trans }}
                </h5>
                <h2>
                    {{ auditEntries }}
                </h2>
            </div>
        </div>
    </div>

    {# =========================================================
       Lizenzstatus
       ========================================================= #}
    <div class="card mb-4">
        <div class="card-header">
            <strong>
                <i class="fa fa-chart-pie me-2"></i>
                {{ 'ui.license_status'|trans }}
            </strong>
        </div>
        <div class="card-body">
            <div class="row text-center">
                {# Aktiv #}
                <div class="col">
                    <a
                        href="{{ dashboardUrls.activeLicenses }}"
                        class="text-decoration-none text-reset"
                    >
                        <div class="fs-4 fw-bold">
                            {{ stats.licenses.active }}
                        </div>
                        <div class="text-muted">
                            {{ 'ui.active'|trans }}
                        </div>
                    </a>
                </div>

                {# Gesperrt #}
                <div class="col">
                    <a
                        href="{{ dashboardUrls.suspendedLicenses }}"
                        class="text-decoration-none text-reset"
                    >
                        <div class="fs-4 fw-bold">
                            {{ stats.licenses.suspended }}
                        </div>
                        <div class="text-muted">
                            {{ 'ui.suspended'|trans }}
                        </div>
                    </a>
                </div>

                {# Widerrufen #}
                <div class="col">
                    <a
                        href="{{ dashboardUrls.revokedLicenses }}"
                        class="text-decoration-none text-reset"
                    >
                        <div class="fs-4 fw-bold">
                            {{ stats.licenses.revoked }}
                        </div>
                        <div class="text-muted">
                            {{ 'ui.revoked'|trans }}
                        </div>
                    </a>
                </div>

                {# Abgelaufen #}
                <div class="col">
                    <a
                        href="{{ dashboardUrls.expiredLicenses }}"
                        class="text-decoration-none text-reset"
                    >
                        <div class="fs-4 fw-bold">
                            {{ stats.licenses.expired }}
                        </div>
                        <div class="text-muted">
                            {{ 'ui.expired'|trans }}
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    {# =========================================================
       Produkte / Module
       ========================================================= #}
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between align-items-center">
                <strong>
                    <i class="fa fa-box me-2"></i>
                    {{ 'ui.by_module'|trans }}
                </strong>
                <a
                    href="{{ dashboardUrls.licenses }}"
                    class="btn btn-sm btn-secondary"
                >
                    {{ 'ui.all_licenses'|trans }}
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead>
                    <tr>
                        <th>{{ 'ui.module'|trans }}</th>
                        <th>{{ 'ui.status'|trans }}</th>
                        <th class="text-end">
                            {{ 'ui.licenses'|trans }}
                        </th>
                        <th class="text-end">
                            {{ 'ui.installations'|trans }}
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in productStatistics %}
                        <tr>
                            <td>
                                <strong>
                                    {{ product.productName ?: product.productSlug }}
                                </strong>
                                {% if product.productName and product.productSlug %}
                                    <div class="small text-muted">
                                        {{ product.productSlug }}
                                    </div>

                                {% endif %}
                            </td>
                            <td>
                                {% if product.productActive %}
                                    <span class="badge bg-success">
                                        {{ 'ui.active'|trans }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        {{ 'ui.inactive'|trans }}
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end fw-bold">
                                {{ product.total }}
                            </td>
                            <td class="text-end">
                                {{ product.activationCount }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td
                                colspan="4"
                                class="text-center text-muted py-4"
                            >
                                {{ 'ui.no_modules'|trans }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
