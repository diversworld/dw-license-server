{% extends 'layout/application.html.twig' %}
{% block title %}{{ (kind == 'api' ? 'api_credentials.title' : 'webhook.title')|trans }} — {{ customer.company }}{% endblock %}
{% block page_content %}<h1>{{ block('title') }}</h1>
{% if secret %}<p class="alert alert-warning">{{ 'api_credentials.once'|trans }}</p><code id="integration-secret" class="d-block text-break rounded bg-light p-3 mb-4">{{ secret }}</code>{% endif %}
{{ form_start(form) }}{{ form_widget(form) }}<button type="submit" class="btn btn-primary">{{ 'api_credentials.create'|trans }}</button>{{ form_end(form) }}
<ul class="list-group list-group-flush mb-4">{% for credential in credentials %}<li class="list-group-item">{{ credential.name }} — {{ credential.scopes|join(', ') }} — {{ credential.expiresAt ? credential.expiresAt|date('Y-m-d H:i') : 'portal.unlimited'|trans }}{% if credential.active %}<form method="post" action="{{ path('admin_api_credential_revoke', {id: credential.id, _locale: app.request.locale}) }}"><input type="hidden" name="_token" value="{{ csrf_token('api_revoke_' ~ credential.id) }}"><button type="submit" class="btn btn-outline-danger btn-sm mt-2">{{ 'api_credentials.revoke'|trans }}</button></form>{% endif %}</li>{% endfor %}
{% for endpoint in endpoints %}<li class="list-group-item">{{ endpoint.url }} — {{ endpoint.events|join(', ') }}{% if endpoint.active %}<form method="post" action="{{ path('admin_webhook_disable', {id: endpoint.id, _locale: app.request.locale}) }}"><input type="hidden" name="_token" value="{{ csrf_token('webhook_disable_' ~ endpoint.id) }}"><button type="submit" class="btn btn-outline-danger btn-sm mt-2">{{ 'api_credentials.revoke'|trans }}</button></form>{% endif %}</li>{% endfor %}</ul>
<h2>{{ 'expiry_reminder.history'|trans }}</h2><ul class="list-group list-group-flush mb-4">{% for delivery in deliveries %}<li class="list-group-item">{{ delivery.eventId }}: {{ delivery.status }} ({{ delivery.attempts }})<ul class="list-group list-group-flush mb-4">{% for attempt in delivery.history %}<li class="list-group-item">{{ attempt.at|date('Y-m-d H:i:s') }} — {{ attempt.status }}{% if attempt.httpStatus %} HTTP {{ attempt.httpStatus }}{% endif %}</li>{% endfor %}</ul></li>{% endfor %}</ul>
{% endblock %}
