{% extends 'layout/application.html.twig' %}

{% block title %}
    {{ 'ui.change_password'|trans }}
{% endblock %}

{% block page_content %}

    <h1>{{ block('title') }}</h1>

    <div class="row">
        <div class="col-12 col-lg-8 col-xl-6">

            <div class="card login-card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fa fa-lock me-2"></i>
                        {{ 'ui.change_password'|trans }}
                    </h5>
                </div>

                <div class="card-body">

                    <p class="text-muted mb-4">
                        {{ 'ui.password_help'|trans }}
                    </p>

                    {{ form_start(passwordForm) }}

                        <div class="mb-4">
                            {{ form_row(
                                passwordForm.currentPassword
                            ) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(
                                passwordForm.newPassword.first
                            ) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(
                                passwordForm.newPassword.second
                            ) }}
                        </div>

                        <div class="alert alert-info mt-4">
                            <i class="fa fa-info-circle me-2"></i>
                            {{ 'ui.password_min'|trans }}
                        </div>

                        <hr>

                        <div
                            class="d-flex justify-content-between"
                        >
                            <a
                                href="{{ path('dashboard_profile') }}"
                                class="btn btn-outline-primary"
                            >
                                <i class="fa fa-arrow-left me-1"></i>
                                {{ 'ui.back_profile'|trans }}
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                <i class="fa fa-key me-1"></i>
                                {{ 'ui.change_password'|trans }}
                            </button>
                        </div>

                    {{ form_end(passwordForm) }}

                </div>

            </div>

        </div>
    </div>

{% endblock %}
