{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Kennwort ändern
{% endblock %}

{% block main %}

    <div class="row">
        <div class="col-12 col-lg-8 col-xl-6">

            <div class="card">

                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fa fa-lock me-2"></i>
                        Kennwort ändern
                    </h5>
                </div>

                <div class="card-body">

                    <p class="text-muted mb-4">
                        Gib dein aktuelles Kennwort und anschließend
                        das gewünschte neue Kennwort ein.
                    </p>

                    {{ form_start(passwordForm) }}

                        <div class="mb-4">
                            {{ form_row(
                                passwordForm.currentPassword
                            ) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(
                                passwordForm.newPassword.first
                            ) }}
                        </div>

                        <div class="mb-3">
                            {{ form_row(
                                passwordForm.newPassword.second
                            ) }}
                        </div>

                        <div class="alert alert-info mt-4">
                            <i class="fa fa-info-circle me-2"></i>
                            Das neue Kennwort muss mindestens
                            12 Zeichen lang sein.
                        </div>

                        <hr>

                        <div
                            class="d-flex justify-content-between"
                        >
                            <a
                                href="{{ path('dashboard_profile') }}"
                                class="btn btn-secondary"
                            >
                                <i class="fa fa-arrow-left me-1"></i>
                                Zurück zum Profil
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary"
                            >
                                <i class="fa fa-key me-1"></i>
                                Kennwort ändern
                            </button>
                        </div>

                    {{ form_end(passwordForm) }}

                </div>

            </div>

        </div>
    </div>

{% endblock %}