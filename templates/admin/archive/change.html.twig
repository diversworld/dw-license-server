{% extends 'base.html.twig' %}
{% block title %}{{ ('archive.' ~ action)|trans }}{% endblock %}
{% block body %}
<main class="container py-4">
    <h1>{{ ('archive.' ~ action)|trans }}</h1>
    <p>{{ entity }} · {{ entity.id }}</p>
    <p>{{ 'archive.notice'|trans }}</p>
    {{ form_start(form) }}{{ form_widget(form) }}
    <button type="submit" class="btn btn-primary">{{ 'license_action.confirm'|trans }}</button>
    {{ form_end(form) }}
    <a href="{{ path('admin_' ~ type ~ '_index', {_locale: app.request.locale}) }}">{{ 'archive.back'|trans }}</a>
</main>
{% endblock %}
