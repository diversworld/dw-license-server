{% extends '@EasyAdmin/crud/index.html.twig' %}

{% block main %}

    {% set licenseView = app.request.query.get('licenseView') %}

    {% if licenseView %}
        {% set viewConfig = {
            'active': {
                'label': 'ui.active_licenses',
                'description': 'ui.active_filter_help',
                'icon': 'fa fa-check-circle'
            },
            'expiring': {
                'label': 'ui.expiring_filter',
                'description': 'ui.expiring_filter_help',
                'icon': 'fa fa-hourglass-half'
            },
            'expired': {
                'label': 'ui.expired_licenses',
                'description': 'ui.expired_filter_help',
                'icon': 'fa fa-times-circle'
            },
            'suspended': {
                'label': 'ui.suspended_licenses',
                'description': 'ui.suspended_filter_help',
                'icon': 'fa fa-ban'
            },
            'revoked': {
                'label': 'ui.revoked_licenses',
                'description': 'ui.revoked_filter_help',
                'icon': 'fa fa-recycle'
            }
        } %}

        {% if viewConfig[licenseView] is defined %}
            {# Render the view based on the selected licenseView #}
            {% set currentView = viewConfig[licenseView] %}
            <div
                class="alert alert-info d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center">
                <div>
                    <div class="fw-bold mb-1">
                    <i class="fa {{ currentView.icon }} me-2"></i>
                        {{ 'ui.licenses'|trans }}
                        <i class="fa fa-angle-right me-2"></i>
                        {{ currentView.label|trans }}
                    </div>
                    <div class="small">
                        {{ currentView.description|trans }}
                    </div>
                    <div class="flex-shrink-0">
                        <a class="btn btn-outline-primary btn-sm mt-2" href="{{ea_url().setController('App\\Controller\\Admin\\LicenseCrudController')
                            .setAction('index')
                            .unset('licenseView')}}">
                            <i class="fa fa-filter-circle-xmark me-1"></i>
                            {{ 'ui.filter_reset'|trans }}
                        </a>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endif %}
    {{ parent() }}
{% endblock %}
