{% extends 'layout/application.html.twig' %}
{% block title %}{{ 'ui.assign_installation'|trans }}{% endblock %}
{% block page_content %}

    <a href="{{ path('admin') }}">{{ 'ui.back_management'|trans }}</a>
    <h1>{{ 'ui.assign_installation'|trans }}</h1>
    <p>{{ license.product }} — {{ license.customer }}</p>
    {{ form_start(form) }}{{ form_widget(form) }}<button type="submit" class="btn btn-primary">{{ 'ui.issue_license'|trans }}</button>{{ form_end(form) }}
    {% if token %}
        <h2>{{ 'ui.signed_license'|trans }}</h2>
        <p>{{ 'ui.signed_help'|trans }}</p>
        <textarea readonly rows="8" class="form-control font-monospace" aria-label="{{ 'ui.signed_license'|trans }}">{{ token }}</textarea>
        <h2>{{ 'ui.public_keys'|trans }}</h2><p>{{ 'ui.keys_help'|trans }} <code>contao_issue_service.license_public_key</code>. {{ 'ui.file'|trans }} <code>config/jwt/public.pem</code> {{ 'ui.jwt_help'|trans }}</p><pre class="dw-code">{{ public_key }}</pre>
        <p>{{ 'ui.validation_endpoint'|trans }} <code>{{ url('api_license_validate') }}</code></p>
    {% endif %}

{% endblock %}
