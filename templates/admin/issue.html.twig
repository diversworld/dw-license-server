{% extends 'base.html.twig' %}
{% block title %}Installation zuweisen{% endblock %}
{% block body %}
<main style="max-width: 60rem; margin: 3rem auto; font-family: sans-serif">
    <a href="{{ path('admin') }}">Zur Lizenzverwaltung</a>
    <h1>Installation zuweisen</h1>
    <p>{{ license.product }} — {{ license.customer }}</p>
    {{ form_start(form) }}{{ form_widget(form) }}<button type="submit">Lizenz ausstellen</button>{{ form_end(form) }}
    {% if token %}
        <h2>Signierte Lizenz</h2>
        <p>Dieses Token in der Contao-Lizenzverwaltung einfügen oder als Datei mit der Endung .lic speichern und importieren.</p>
        <textarea readonly rows="8" style="width:100%" aria-label="Signierte Lizenz">{{ token }}</textarea>
        <h2>Öffentliche Ed25519-Prüfschlüssel</h2><p>Diese JSON-Schlüsselliste in Contao als <code>contao_issue_service.license_public_key</code> eintragen. Die Datei <code>config/jwt/public.pem</code> gehört zur separaten JWT-Anmeldung und ist hierfür ungeeignet.</p><pre style="white-space:pre-wrap">{{ public_key }}</pre>
        <p>Validierungs-Endpunkt: <code>{{ url('api_license_validate') }}</code></p>
    {% endif %}
</main>
{% endblock %}
