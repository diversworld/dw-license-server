{% extends 'layout/authentication.html.twig' %}
{% block title %}{{ 'ui.check_email'|trans }}{% endblock %}
{% block auth_content %}
    <div class="text-center">
        <i class="bi bi-envelope-check text-primary display-4 d-block mb-4" aria-hidden="true"></i>
        <p class="text-secondary">{{ 'ui.reset_sent'|trans }}</p>
        {% if resetToken %}<p class="text-secondary small">{{ 'ui.reset_expiry'|trans }}</p>{% endif %}
        <a href="{{ path('app_login') }}" class="btn btn-outline-primary mt-3">{{ 'ui.login_link'|trans }}</a>
    </div>
{% endblock %}
