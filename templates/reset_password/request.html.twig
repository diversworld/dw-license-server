{% extends 'layout/authentication.html.twig' %}
{% block title %}{{ 'ui.reset_title'|trans }}{% endblock %}
{% block auth_content %}
    <p class="text-secondary mb-4">{{ 'ui.reset_help'|trans }}</p>
    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-envelope me-2" aria-hidden="true"></i>{{ 'ui.reset_request'|trans }}</button>
    {{ form_end(requestForm) }}
    <div class="text-center mt-4"><a href="{{ path('app_login') }}" class="text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>{{ 'ui.back_login'|trans }}</a></div>
{% endblock %}
