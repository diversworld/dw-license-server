{% extends 'layout/authentication.html.twig' %}
{% block title %}Kennwort zurücksetzen{% endblock %}
{% block auth_content %}
    <p class="text-secondary mb-4">Gib die E-Mail-Adresse deines Benutzerkontos ein. Wir senden dir einen Link, mit dem du ein neues Kennwort festlegen kannst.</p>
    {{ form_start(requestForm) }}
        {{ form_row(requestForm.email) }}
        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-envelope me-2" aria-hidden="true"></i>Reset-Link anfordern</button>
    {{ form_end(requestForm) }}
    <div class="text-center mt-4"><a href="{{ path('app_login') }}" class="text-decoration-none"><i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Zurück zur Anmeldung</a></div>
{% endblock %}
