{% extends 'base.html.twig' %}

{% block title %}
    Kennwort vergessen | Diversworld
{% endblock %}

{% block body %}

<div class="container-fluid">
    <div class="row min-vh-100">

        <div
            class="
                col-lg-6
                login-brand
                d-none d-lg-flex
                flex-column
                justify-content-between
                p-5
            "
        >

            <div class="brand-content">
                <div class="d-flex align-items-center gap-3">

                    <div class="brand-logo">
                        DW
                    </div>

                    <div class="fw-bold fs-5">
                        Diversworld
                    </div>

                </div>
            </div>

            <div class="brand-content">

                <div
                    class="
                        text-uppercase
                        fw-semibold
                        text-info
                        small
                        mb-3
                    "
                >
                    Lizenzverwaltung
                </div>

                <h1 class="brand-title mb-4">
                    Kennwort vergessen?
                </h1>

                <p class="brand-description">
                    Kein Problem. Gib deine E-Mail-Adresse
                    ein und wir senden dir einen Link, mit
                    dem du ein neues Kennwort festlegen kannst.
                </p>

            </div>

            <div class="brand-content text-white-50 small">
                &copy; {{ "now"|date("Y") }} Diversworld
            </div>

        </div>


        <div
            class="
                col-lg-6
                login-area
                d-flex
                align-items-center
                justify-content-center
                p-4
            "
        >

            <div class="login-wrapper">

                <div class="card login-card">

                    <div class="card-body">

                        <h2 class="fw-bold mb-2">
                            Kennwort zurücksetzen
                        </h2>

                        <p class="text-secondary mb-4">
                            Gib die E-Mail-Adresse deines
                            Benutzerkontos ein.
                        </p>

                        {{ form_start(requestForm) }}

                            <div class="mb-4">

                                {{ form_label(
                                    requestForm.email,
                                    null,
                                    {
                                        label_attr: {
                                            class:
                                                'form-label fw-semibold'
                                        }
                                    }
                                ) }}

                                {{ form_widget(
                                    requestForm.email,
                                    {
                                        attr: {
                                            class:
                                                'form-control'
                                        }
                                    }
                                ) }}

                                {{ form_errors(
                                    requestForm.email
                                ) }}

                            </div>

                            <button
                                type="submit"
                                class="btn btn-primary w-100"
                            >
                                <i class="bi bi-envelope me-2"></i>
                                Reset-Link anfordern
                            </button>

                        {{ form_end(requestForm) }}

                        <div class="text-center mt-4">

                            <a
                                href="{{ path('app_login') }}"
                                class="text-decoration-none"
                            >
                                <i
                                    class="
                                        bi
                                        bi-arrow-left
                                        me-1
                                    "
                                ></i>

                                Zurück zur Anmeldung
                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</div>

{% endblock %}