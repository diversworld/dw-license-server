{% extends 'layout/authentication.html.twig' %}
{% block title %}Neues Kennwort festlegen{% endblock %}
{% block auth_content %}
    <p class="text-secondary mb-4">Gib dein neues Kennwort zweimal ein.</p>
    {{ form_start(resetForm) }}
        {{ form_errors(resetForm) }}
        {{ form_row(resetForm.plainPassword.first) }}
        {{ form_row(resetForm.plainPassword.second) }}
        <div class="alert alert-info">Das Kennwort muss mindestens 12 Zeichen lang sein.</div>
        <button type="submit" class="btn btn-primary w-100">Kennwort speichern</button>
    {{ form_end(resetForm) }}
{% endblock %}
