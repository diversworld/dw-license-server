{% extends 'base.html.twig' %}
{% block login %}
    <main class="col-lg-6 login-area d-flex align-items-center justify-content-center p-4">
        <div class="login-wrapper login-wrapper-wide">
            <div class="d-lg-none text-center mb-4"><strong class="fs-4">Diversworld</strong></div>
            <div class="card login-card"><div class="card-body">
                <h1 class="h3 fw-bold mb-4">{{ block('title') }}</h1>
                {% include 'layout/flashes.html.twig' %}
                {% block auth_content %}{% endblock %}
            </div></div>
        </div>
    </main>
{% endblock %}
