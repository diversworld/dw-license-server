{% extends 'layout/authentication.html.twig' %}

{% block title %}{{ 'two_factor.title'|trans }}{% endblock %}

{% block auth_content %}

    <div class="two-factor-container">

        <div class="two-factor-description">
            <p>{{ 'two_factor.challenge_help'|trans }}</p>
        </div>
        {% if authenticationError %}
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
                <div>
                    {{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}
                </div>
            </div>
        {% endif %}
         <div class="border-0">
            <div class="p-0">
                <div class="mb-4">
                    <form action="{{ path('2fa_login_check') }}" method="post">
                        <div class="mb-3">
                            <label for="auth-code" class="form-label">{{ 'two_factor.code'|trans }}</label>
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-envelope"></i>
                                    </span>
                                    <input class="form-control" id="auth-code" name="{{ authCodeParameterName }}" autocomplete="one-time-code" aria-describedby="auth-code-help" required autofocus>
                                </div>
                                <div id="auth-code-help" class="form-text">{{ 'form_help.auth_proof'|trans }}</div>
                            </div>
                        <div class="mb-3">
                            <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
                            <button type="submit" class="btn btn-primary w-100">{{ 'two_factor.verify'|trans }}</button>
                        </div>
                    </form>
                    <p><a href="{{ path('two_factor_recover') }}">{{ 'two_factor.recover'|trans }}</a></p>
                    <a href="{{ logoutPath }}">{{ 'dashboard.logoff'|trans }}</a>
                </div>
            </div>
        </div>
    </div>

{% endblock %}
