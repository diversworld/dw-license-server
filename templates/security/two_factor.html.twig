{% extends 'base.html.twig' %}
{% block title %}{{ 'two_factor.title'|trans }}{% endblock %}
{% block body %}
<main class="container" style="max-width: 32rem; margin: 3rem auto">
    <h1>{{ 'two_factor.title'|trans }}</h1>
    <p>{{ 'two_factor.challenge_help'|trans }}</p>
    {% if authenticationError %}<p role="alert">{{ authenticationError|trans(authenticationErrorData, 'SchebTwoFactorBundle') }}</p>{% endif %}
    <form action="{{ path('2fa_login_check') }}" method="post">
        <label for="auth-code">{{ 'two_factor.code'|trans }}</label>
        <input id="auth-code" name="{{ authCodeParameterName }}" autocomplete="one-time-code" required autofocus>
        <input type="hidden" name="{{ csrfParameterName }}" value="{{ csrf_token(csrfTokenId) }}">
        <button type="submit">{{ 'two_factor.verify'|trans }}</button>
    </form>
    <a href="{{ logoutPath }}">{{ 'dashboard.logoff'|trans }}</a>
</main>
{% endblock %}
