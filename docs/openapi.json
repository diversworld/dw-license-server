{
    "openapi": "3.0.0",
    "info": {
        "title": "Diversworld License API",
        "description": "Version 1 of the license activation and renewal API. Use HTTPS.\nCredentials are sent in JSON request bodies, never in URLs.\nLicense tokens use Ed25519 and are not JWTs.\nRequests are limited to 60 per minute per client IP, method and path.\n",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/",
            "description": "Current license server"
        }
    ],
    "paths": {
        "/api/v1/licenses/activate": {
            "post": {
                "tags": [
                    "Licenses"
                ],
                "summary": "Activate an installation",
                "description": "Repeated activation for the same tenant and domain returns a fresh token without allocating another slot. Offline licenses require an expiry date.",
                "operationId": "activateInstallation",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ActivationRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Signed license token",
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "example": "no-store"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "409": {
                        "$ref": "#/components/responses/Conflict"
                    },
                    "410": {
                        "$ref": "#/components/responses/Gone"
                    },
                    "415": {
                        "$ref": "#/components/responses/UnsupportedMediaType"
                    },
                    "422": {
                        "$ref": "#/components/responses/UnprocessableEntity"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "503": {
                        "$ref": "#/components/responses/ServiceUnavailable"
                    }
                },
                "security": []
            }
        },
        "/api/v1/licenses/validate": {
            "post": {
                "tags": [
                    "Licenses"
                ],
                "summary": "Renew an online license token",
                "description": "Expired online tokens may be renewed when their signature and installation binding remain valid and the license is usable. Offline tokens cannot be renewed.",
                "operationId": "renewLicenseToken",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RefreshRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Signed license token",
                        "headers": {
                            "Cache-Control": {
                                "schema": {
                                    "type": "string",
                                    "example": "no-store"
                                }
                            }
                        },
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TokenResponse"
                                }
                            }
                        }
                    },
                    "400": {
                        "$ref": "#/components/responses/BadRequest"
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthorized"
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "410": {
                        "$ref": "#/components/responses/Gone"
                    },
                    "415": {
                        "$ref": "#/components/responses/UnsupportedMediaType"
                    },
                    "422": {
                        "$ref": "#/components/responses/UnprocessableEntity"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "503": {
                        "$ref": "#/components/responses/ServiceUnavailable"
                    }
                },
                "security": []
            }
        },
        "/api/v1/management/licenses": {
            "post": {
                "tags": [
                    "Management"
                ],
                "summary": "Create a license in the credential customer scope",
                "operationId": "createCustomerLicense",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "maxLength": 128
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ManagementCreateRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "License identifier, secret licenseKey and expiry; repeated identical keys return the same response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "licenseId",
                                        "licenseKey",
                                        "expiresAt"
                                    ],
                                    "properties": {
                                        "licenseId": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "licenseKey": {
                                            "type": "string"
                                        },
                                        "expiresAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing or invalid idempotency key"
                    },
                    "415": {
                        "description": "JSON content type required"
                    },
                    "429": {
                        "description": "API rate limit reached"
                    },
                    "401": {
                        "description": "Invalid/expired/revoked credential"
                    },
                    "403": {
                        "description": "Missing licenses:create scope"
                    },
                    "409": {
                        "description": "Conflicting idempotency payload"
                    },
                    "422": {
                        "description": "Invalid license data"
                    }
                },
                "security": [
                    {
                        "apiBearer": []
                    }
                ]
            }
        },
        "/api/v1/management/licenses/{id}/renew": {
            "post": {
                "tags": [
                    "Management"
                ],
                "summary": "Extend a license without changing suspension or revocation",
                "operationId": "extendCustomerLicense",
                "parameters": [
                    {
                        "name": "Idempotency-Key",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "maxLength": 128
                        }
                    },
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/ManagementRenewRequest"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "License identifier, new expiry and unchanged status",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "licenseId",
                                        "expiresAt",
                                        "status"
                                    ],
                                    "properties": {
                                        "licenseId": {
                                            "type": "string",
                                            "format": "uuid"
                                        },
                                        "expiresAt": {
                                            "type": "string",
                                            "format": "date-time"
                                        },
                                        "status": {
                                            "type": "string"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing or invalid idempotency key"
                    },
                    "415": {
                        "description": "JSON content type required"
                    },
                    "429": {
                        "description": "API rate limit reached"
                    },
                    "401": {
                        "description": "Invalid/expired/revoked credential"
                    },
                    "403": {
                        "description": "Scope or customer ownership denied"
                    },
                    "404": {
                        "description": "Unknown or foreign license"
                    },
                    "409": {
                        "description": "Conflicting idempotency payload"
                    },
                    "422": {
                        "description": "Invalid extension"
                    }
                },
                "security": [
                    {
                        "apiBearer": []
                    }
                ]
            }
        }
    },
    "components": {
        "schemas": {
            "TokenResponse": {
                "required": [
                    "token"
                ],
                "properties": {
                    "token": {
                        "description": "base64url(JSON claims).base64url(Ed25519 signature); contains a signing key identifier",
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "Problem": {
                "properties": {
                    "type": {
                        "type": "string"
                    },
                    "title": {
                        "type": "string"
                    },
                    "status": {
                        "type": "integer"
                    },
                    "detail": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "ActivationRequest": {
                "required": [
                    "licenseKey",
                    "product",
                    "tenant",
                    "domain"
                ],
                "properties": {
                    "licenseKey": {
                        "type": "string",
                        "default": "",
                        "maxLength": 64,
                        "minLength": 64
                    },
                    "product": {
                        "type": "string",
                        "default": "",
                        "maxLength": 255
                    },
                    "tenant": {
                        "type": "string",
                        "default": "",
                        "maxLength": 180
                    },
                    "domain": {
                        "type": "string",
                        "default": "",
                        "maxLength": 253
                    }
                },
                "type": "object"
            },
            "RefreshRequest": {
                "required": [
                    "token",
                    "tenant",
                    "domain"
                ],
                "properties": {
                    "token": {
                        "type": "string",
                        "default": "",
                        "maxLength": 16384
                    },
                    "tenant": {
                        "type": "string",
                        "default": "",
                        "maxLength": 180
                    },
                    "domain": {
                        "type": "string",
                        "default": "",
                        "maxLength": 253
                    }
                },
                "type": "object"
            },
            "ManagementCreateRequest": {
                "required": [
                    "product",
                    "reason"
                ],
                "properties": {
                    "product": {
                        "type": "string",
                        "default": "",
                        "maxLength": 255
                    },
                    "expiresAt": {
                        "description": "Future expiry for custom issuance; omit when selecting a plan.",
                        "type": "string",
                        "format": "date-time",
                        "default": ""
                    },
                    "mode": {
                        "type": "string",
                        "default": "online",
                        "enum": [
                            "online",
                            "offline"
                        ]
                    },
                    "features": {
                        "oneOf": [
                            {
                                "type": "array",
                                "items": {
                                    "nullable": true
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "nullable": true
                                }
                            }
                        ],
                        "default": []
                    },
                    "maxDomains": {
                        "type": "integer",
                        "default": 1,
                        "maximum": 10000,
                        "minimum": 0,
                        "exclusiveMinimum": true
                    },
                    "reason": {
                        "type": "string",
                        "default": "",
                        "maxLength": 1000,
                        "minLength": 3
                    },
                    "plan": {
                        "description": "Optional active plan UUID; its duration and grants replace custom expiry/features/quotas/installations.",
                        "type": "string",
                        "format": "uuid",
                        "nullable": true,
                        "default": null
                    },
                    "quotas": {
                        "oneOf": [
                            {
                                "type": "array",
                                "items": {
                                    "nullable": true
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": {
                                    "nullable": true
                                }
                            }
                        ],
                        "default": []
                    }
                },
                "type": "object",
                "oneOf": [
                    {
                        "required": [
                            "expiresAt"
                        ]
                    },
                    {
                        "required": [
                            "plan"
                        ]
                    }
                ]
            },
            "ManagementRenewRequest": {
                "properties": {
                    "expiresAt": {
                        "type": "string",
                        "default": ""
                    },
                    "reason": {
                        "type": "string",
                        "default": "",
                        "maxLength": 1000,
                        "minLength": 3
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "BadRequest": {
                "description": "Malformed JSON or request structure",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "Unauthorized": {
                "description": "Invalid token structure or signature",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Unknown, disabled or archived license, customer, product or installation; invalid binding",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "Conflict": {
                "description": "Installation limit reached",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "Gone": {
                "description": "License expired",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "UnsupportedMediaType": {
                "description": "Request must use application/json",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "UnprocessableEntity": {
                "description": "Input validation failed, required feature missing or offline expiry missing",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Rate limit exceeded; retry later",
                "headers": {
                    "Retry-After": {
                        "schema": {
                            "type": "string"
                        }
                    }
                },
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            },
            "ServiceUnavailable": {
                "description": "Concurrent license operation; retry later",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/Problem"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "apiBearer": {
                "type": "http",
                "description": "Customer-scoped API credential with explicit create/renew scopes",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Licenses",
            "description": "Installation activation and online token renewal"
        },
        {
            "name": "Management",
            "description": "Management"
        }
    ]
}
